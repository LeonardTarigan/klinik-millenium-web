---
import { Icon } from 'astro-icon/components';

interface Props {
    day: string
    time: string
    iconName: string
}

const { day, time, iconName } = Astro.props
---

<div class="bg-white rounded-2xl flex flex-col justify-between border p-5 relative z-0">
    <Icon name={iconName} class="size-25 text-zinc-100 -z-10 absolute right-1 bottom-1" />

    <p class="text-zinc-500 uppercase font-medium text-sm">
        {day}
    </p>

    <p class="font-bold text-xl">
        {time}
    </p>

</div>