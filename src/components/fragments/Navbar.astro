---
import BrandLogo from "../logo/BrandLogo.astro";

const links = [
    { label: "Program", href: "#program" },
    { label: "Layanan", href: "#layanan" },
    { label: "Mitra", href: "#mitra" },
    { label: "Lokasi", href: "#lokasi" },
];
---

<nav class="px-20 py-5 border sticky top-0 bg-white z-10 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
        <BrandLogo class="size-10 text-primary" />
    </a>

    <div class="flex gap-10 text-zinc-500">
        {
            links.map((link) => (
                <a
                    href={link.href}
                    data-nav-link
                    class="underline decoration-transparent decoration-2 underline-offset-8 transition-colors hover:text-zinc-950 aria-[current=location]:text-primary aria-[current=location]:decoration-primary"
                >
                    {link.label}
                </a>
            ))
        }
    </div>

    <div></div>
</nav>

<script>
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
    const visible = new Set<string>();

    const setActive = () => {
        const current = links.find((link) => visible.has(link.hash.slice(1)));
        links.forEach((link) => {
            if (link === current) link.setAttribute("aria-current", "location");
            else link.removeAttribute("aria-current");
        });
    };

    // Only a thin band around 40% down the viewport counts as "currently viewing"
    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) visible.add(entry.target.id);
                else visible.delete(entry.target.id);
            }
            setActive();
        },
        { rootMargin: "-40% 0px -55% 0px" },
    );

    links.forEach((link) => {
        const section = document.getElementById(link.hash.slice(1));
        if (section) observer.observe(section);
    });
</script>