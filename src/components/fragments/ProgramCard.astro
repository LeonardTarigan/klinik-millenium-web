---
import { Icon } from 'astro-icon/components';

interface Props {
    abbriviation: string
    name: string
    description: string
    iconName: string
}

const { abbriviation, name, description, iconName } = Astro.props
---

<div class="bg-white">
    <div class="space-y-5">
        <Icon name={iconName} class="size-10 text-primary" />
        <div>
            <h3 class="font-bold text-2xl">{abbriviation}</h3>
            <p class="text-lg">{name}</p>
        </div>
    </div>

    <p class="text-zinc-500 mt-5">{description}</p>
</div>