---
import { Icon } from 'astro-icon/components';

interface Props {
    title: string
    description: string
    iconName: string
}

const { title, description, iconName } = Astro.props
---

<div class="flex gap-3">
    <Icon name={iconName} class="size-14 -translate-y-3 text-primary" />
    <div>
        <h3 class="font-bold text-xl">{title}</h3>
        <p class="text-zinc-500">{description}</p>
    </div>
</div>