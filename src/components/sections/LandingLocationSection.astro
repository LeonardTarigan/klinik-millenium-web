---
interface Props {
  name?: string;
  street?: string;
  district?: string;
  city?: string;
  postalCode?: string;
  phone?: string;
  phoneHref?: string;
  whatsapp?: string;
  whatsappHref?: string;
  email?: string;
  instagram?: string;
  instagramHref?: string;
  mapEmbedSrc?: string;
}

const {
  name = "Klinik Pratama Millenium",
  street = "Jalan Kapten Muslim No. 18 C",
  district = "Medan Helvetia",
  city = "Medan, Sumatera Utara",
  postalCode = "20124",
  phone = "(061) 8446652",
  phoneHref = "tel:+62618446652",
  whatsapp = "0813-7133-1419",
  whatsappHref = "https://wa.me/6281371331419",
  email = "klinikmillenium.74@gmail.com",
  instagram = "@klinik_millenium",
  instagramHref = "https://instagram.com/klinik_millenium",
  mapEmbedSrc,
} = Astro.props;

const query = encodeURIComponent(`${name} ${street} ${district} ${city}`);

const embedSrc =
  mapEmbedSrc ?? `https://www.google.com/maps?q=${query}&hl=id&z=16&output=embed`;

const contacts = [
  {
    label: "Telepon",
    value: phone,
    href: phoneHref,
    external: false,
    icon: "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z",
  },
  {
    label: "WhatsApp",
    value: whatsapp,
    href: whatsappHref,
    external: true,
    icon: "M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5Z",
  },
  {
    label: "Email",
    value: email,
    href: `mailto:${email}`,
    external: false,
    icon: "M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm-2 2 9 6 9-6",
  },
  {
    label: "Instagram",
    value: instagram,
    href: instagramHref,
    external: true,
    icon: "M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Zm4 6.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm5.5-2.5h.01",
  },
];
---

<section id="lokasi" class="py-16 md:py-24 lg:py-32">
  <div>
    <header class="mb-20 flex justify-between relative">
        <h2 class="font-bold text-5xl">Lokasi Kami.</h2>
        <h2 class="font-black text-7xl top-4 text-zinc-100 -z-10 absolute">Lokasi Kami.</h2>
        <p class="text-zinc-500 max-w-xl">
            Mudah dijangkau di Kecamatan Medan Helvetia. Datang langsung, atau hubungi kami lebih dulu
        untuk memastikan layanan yang Anda butuhkan.
        </p>
    </header>

    <!-- Info + map -->
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
      <!-- Info column -->
      <div class="flex flex-col gap-7 lg:col-span-5">
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {
            contacts.map((c) => (
              <li>
                <a
                  href={c.href}
                  target={c.external ? "_blank" : undefined}
                  rel={c.external ? "noopener noreferrer" : undefined}
                  class="flex items-center gap-3.5 rounded-2xl border border-neutral-200 bg-white px-4 py-3 text-neutral-950 transition-colors hover:border-[#a50e16] hover:bg-[#a50e16]/[0.03] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#a50e16]"
                >
                  <span
                    class="grid size-9 flex-none place-items-center rounded-lg bg-[#a50e16]/10 text-[#a50e16]"
                    aria-hidden="true"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="size-[18px]"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={c.icon} />
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <small class="mb-0.5 block text-xs text-neutral-500">{c.label}</small>
                    <strong class="wrap-break-word text-[0.95rem] font-semibold">{c.value}</strong>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="relative min-h-90 overflow-hidden rounded-[1.75rem] border border-neutral-200 bg-neutral-100 lg:col-span-7 lg:min-h-120"
      >
        <iframe
          title={`Peta lokasi ${name}`}
          src={embedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          class="absolute inset-0 size-full border-0">
        </iframe>
      </div>
    </div>
  </div>
</section>