---
import { Icon } from "astro-icon/components";

interface Props {
    name?: string;
    street?: string;
    district?: string;
    city?: string;
    postalCode?: string;
    phone?: string;
    phoneHref?: string;
    whatsapp?: string;
    whatsappHref?: string;
    email?: string;
    instagram?: string;
    instagramHref?: string;
    tiktok?: string;
    tiktokHref?: string;
    mapEmbedSrc?: string;
}

const {
    name = "Klinik Pratama Millenium",
    street = "Jalan Kapten Muslim No. 18 C",
    district = "Medan Helvetia",
    city = "Medan, Sumatera Utara",
    postalCode = "20124",
    phone = "(061) 8446652",
    phoneHref = "tel:+62618446652",
    whatsapp = "0813-7133-1419",
    whatsappHref = "https://wa.me/6281371331419",
    email = "klinikmillenium.74@gmail.com",
    instagram = "@klinik_millenium",
    instagramHref = "https://instagram.com/klinik_millenium",
    tiktok = "@klinikmillenium",
    tiktokHref = "https://www.tiktok.com/@klinikmillenium",
    mapEmbedSrc,
} = Astro.props;

const query = encodeURIComponent(`${name} ${street} ${district} ${city}`);

// Free embed: no API key required
const embedSrc = mapEmbedSrc ?? `https://www.google.com/maps?q=${query}&hl=id&z=16&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${query}`;

const contacts = [
    {
        label: "Alamat",
        value: `${street}, Kec. ${district}, ${city} ${postalCode}`,
        href: directionsHref,
        external: true,
        wide: true,
        icon: "akar-icons:location",
    },
    {
        label: "Telepon",
        value: phone,
        href: phoneHref,
        external: false,
        icon: "akar-icons:phone",
    },
    {
        label: "WhatsApp",
        value: whatsapp,
        href: whatsappHref,
        external: true,
        icon: "akar-icons:whatsapp-fill",
    },
    {
        label: "Instagram",
        value: instagram,
        href: instagramHref,
        external: true,
        icon: "akar-icons:instagram-fill",
    },
    {
        label: "TikTok",
        value: tiktok,
        href: tiktokHref,
        external: true,
        icon: "akar-icons:tiktok-fill",
    },
    {
        label: "Email",
        value: email,
        href: `mailto:${email}`,
        external: false,
        wide: true,
        icon: "akar-icons:envelope",
    },
];
---

<section id="lokasi" class="scroll-mt-24 py-40">
    <header class="relative mb-20 flex justify-between">
        <h2 class="text-5xl font-bold">Lokasi Kami.</h2>
        <h2 aria-hidden="true" class="absolute top-4 -z-10 text-7xl font-black text-zinc-100">
            Lokasi Kami.
        </h2>
        <p class="max-w-xl text-lg text-zinc-500">
            Mudah dijangkau di Kecamatan Medan Helvetia. Datang langsung, atau hubungi kami lebih
            dulu untuk memastikan layanan yang Anda butuhkan.
        </p>
    </header>

    <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Contacts -->
        <ul class="grid content-start gap-3 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
            {
                contacts.map((c) => (
                    <li class:list={[c.wide && "sm:col-span-2 lg:col-span-1"]}>
                        <a
                            href={c.href}
                            target={c.external ? "_blank" : undefined}
                            rel={c.external ? "noopener noreferrer" : undefined}
                            class="hover:border-primary hover:bg-primary/3 focus-visible:outline-primary flex items-center gap-3.5 rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-zinc-950 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
                        >
                            <Icon name={c.icon} class="size-5 text-primary shrink-0" />
                            <span class="min-w-0">
                                <small class="mb-0.5 block text-xs text-zinc-500">{c.label}</small>
                                <strong class="wrap-break-word font-semibold">{c.value}</strong>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- Map -->
        <div
            class="relative min-h-90 overflow-hidden rounded-3xl border border-zinc-200 bg-zinc-100 lg:col-span-7 lg:min-h-120"
        >
            <iframe
                title={`Peta lokasi ${name}`}
                src={embedSrc}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
                class="absolute inset-0 size-full border-0"></iframe>
        </div>
    </div>
</section>