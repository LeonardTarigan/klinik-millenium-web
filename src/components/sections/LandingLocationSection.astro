---
/**
 * Lokasi.astro
 * Location section for Klinik Pratama Millenium.
 * Map: Google Maps embed via iframe (free, no API key needed).
 */

interface Props {
  name?: string;
  street?: string;
  district?: string;
  city?: string;
  postalCode?: string;
  phone?: string;
  phoneHref?: string;
  whatsapp?: string;
  whatsappHref?: string;
  email?: string;
  instagram?: string;
  instagramHref?: string;
  /** Optional: paste the src from Google Maps > Share > Embed a map for a precise pin */
  mapEmbedSrc?: string;
}

const {
  name = "Klinik Pratama Millenium",
  street = "Jalan Kapten Muslim No. 18 C",
  district = "Medan Helvetia",
  city = "Medan, Sumatera Utara",
  postalCode = "20124",
  phone = "(061) 8446652",
  phoneHref = "tel:+62618446652",
  whatsapp = "0813-7133-1419",
  whatsappHref = "https://wa.me/6281371331419",
  email = "Klinikmillenium.74@gmail.com",
  instagram = "@klinikmillenium",
  instagramHref = "https://instagram.com/klinikmillenium",
  mapEmbedSrc,
} = Astro.props;

const query = encodeURIComponent(`${name} ${street} ${district} ${city}`);

// Free embed: no API key required
const embedSrc = mapEmbedSrc ?? `https://www.google.com/maps?q=${query}&hl=id&z=16&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${query}`;
const openMapHref = `https://www.google.com/maps/search/?api=1&query=${query}`;
---

<section id="lokasi" class="lokasi">
  <div class="lokasi__container">
    <header class="lokasi__header">
      <h2 class="lokasi__title" data-ghost="Lokasi.">Lokasi.</h2>
      <p class="lokasi__intro">
        Mudah dijangkau di jantung Kecamatan Medan Helvetia. Kunjungi kami langsung,
        atau hubungi lebih dulu untuk memastikan layanan yang Anda butuhkan.
      </p>
    </header>

    <div class="lokasi__grid">
      <!-- Info column -->
      <div class="lokasi__info">
        <div class="lokasi__address">
          <span class="lokasi__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div>
            <h3>{name}</h3>
            <address>
              {street}<br />
              Kec. {district}, {city}<br />
              {postalCode}
            </address>
          </div>
        </div>

        <ul class="lokasi__contacts">
          <li>
            <a href={phoneHref}>
              <span class="lokasi__icon lokasi__icon--sm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
              </span>
              <span>
                <small>Telepon</small>
                <strong>{phone}</strong>
              </span>
            </a>
          </li>
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer">
              <span class="lokasi__icon lokasi__icon--sm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5Z"/></svg>
              </span>
              <span>
                <small>WhatsApp</small>
                <strong>{whatsapp}</strong>
              </span>
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`}>
              <span class="lokasi__icon lokasi__icon--sm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              </span>
              <span>
                <small>Email</small>
                <strong>{email}</strong>
              </span>
            </a>
          </li>
          <li>
            <a href={instagramHref} target="_blank" rel="noopener noreferrer">
              <span class="lokasi__icon lokasi__icon--sm" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></svg>
              </span>
              <span>
                <small>Instagram</small>
                <strong>{instagram}</strong>
              </span>
            </a>
          </li>
        </ul>

        <div class="lokasi__actions">
          <a class="btn btn--primary" href={directionsHref} target="_blank" rel="noopener noreferrer">Petunjuk Arah</a>
          <a class="btn btn--ghost" href={whatsappHref} target="_blank" rel="noopener noreferrer">Chat WhatsApp</a>
        </div>
      </div>

      <!-- Map column -->
      <div class="lokasi__map">
        <iframe
          title={`Peta lokasi ${name}`}
          src={embedSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="lokasi__badge" href={openMapHref} target="_blank" rel="noopener noreferrer">
          Buka di Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .lokasi {
    --brand: var(--color-primary, #a50e16);
    --brand-dark: var(--color-primary-dark, #8a0a12);
    --ink: var(--color-ink, #0a0a0a);
    --muted: var(--color-muted, #5f6368);
    --line: var(--color-line, #e5e7eb);
    --surface: var(--color-surface, #f4f4f5);

    padding-block: clamp(4rem, 9vw, 8rem);
    scroll-margin-top: 4.5rem; /* offset for the sticky navbar */
  }

  .lokasi__container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 4rem);
  }

  /* Header: same "title + ghost echo" treatment as other sections */
  .lokasi__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .lokasi__title {
    position: relative;
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
  }

  .lokasi__title::after {
    content: attr(data-ghost);
    position: absolute;
    left: 0;
    top: 0.45em;
    z-index: -1;
    color: var(--ink);
    opacity: 0.05;
    filter: blur(1px);
    pointer-events: none;
    user-select: none;
  }

  .lokasi__intro {
    max-width: 30rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Grid */
  .lokasi__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .lokasi__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
      align-items: stretch;
    }
  }

  /* Info */
  .lokasi__info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .lokasi__address {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .lokasi__address h3 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .lokasi__address address {
    font-style: normal;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .lokasi__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 9%, white);
  }

  .lokasi__icon--sm {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
  }

  .lokasi__contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 520px) and (max-width: 959px) {
    .lokasi__contacts {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lokasi__contacts a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .lokasi__contacts a:hover {
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 3%, white);
  }

  .lokasi__contacts small {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 0.1rem;
  }

  .lokasi__contacts strong {
    font-size: 0.95rem;
    font-weight: 600;
    word-break: break-word;
  }

  /* Buttons (match hero buttons) */
  .lokasi__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn--primary {
    background: var(--brand);
    color: #fff;
    border: 1px solid var(--brand);
  }

  .btn--primary:hover {
    background: var(--brand-dark);
    border-color: var(--brand-dark);
  }

  .btn--ghost {
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .btn--ghost:hover {
    border-color: var(--ink);
  }

  /* Map */
  .lokasi__map {
    position: relative;
    min-height: 360px;
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .lokasi__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Echoes the "TERAKREDITASI PARIPURNA" badge on the hero image */
  .lokasi__badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.75rem;
    background: #fff;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
  }

  .lokasi__badge:hover {
    color: var(--brand);
  }

  a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
</style>