---
import MandiriInhealthLogo from "../logo/MandiriInhealthLogo.astro";
import BRILifeLogo from "../logo/BRILifeLogo.astro";
import BPJSKesehatanLogo from "../logo/BPJSKesehatanLogo.astro";
import BPJSKetenagakerjaanLogo from "../logo/BPJSKetenagakerjaanLogo.astro";
---

<section id="mitra" class="scroll-mt-24 py-20 flex flex-col gap-12 items-center lg:py-40 lg:gap-20">
    <div class="relative flex flex-col items-center w-full space-y-6 text-center lg:space-y-10">
        <h2 class="font-bold text-3xl sm:text-4xl lg:text-5xl">Mitra Penjamin Kesehatan.</h2>
        <h2 aria-hidden="true" class="absolute top-2 -z-10 text-4xl font-black text-zinc-100 sm:text-5xl md:text-6xl lg:top-4 lg:text-7xl">
            Mitra Penjamin Kesehatan.
        </h2>
        <p class="max-w-3xl text-zinc-500">Kami melayani peserta BPJS Kesehatan sebagai Fasilitas Kesehatan Tingkat Pertama (FKTP), serta bekerja sama dengan BPJS Ketenagakerjaan, Mandiri Inhealth, dan BRI Life. Kami juga melayani kesehatan karyawan instansi pemerintah dan perusahaan swasta.</p>
    </div>
    <div class="text-zinc-400 flex flex-wrap items-center justify-center gap-x-10 gap-y-8 xl:gap-20">
        <BPJSKesehatanLogo class="h-9 w-48 xl:h-12 xl:w-64" />
        <BPJSKetenagakerjaanLogo class="h-9 w-33 xl:h-12 xl:w-44" />
        <MandiriInhealthLogo class="h-9 w-19.5 -translate-y-1 xl:h-12 xl:w-26" />
        <BRILifeLogo class="h-9 w-24 xl:h-12 xl:w-32" />
    </div>
</section>