---
import Footer from "@/components/fragments/Footer.astro";
import Navbar from "@/components/fragments/Navbar.astro";
import "@/styles/starwind.css";

interface Props {
    /** Page title. Leave empty on the homepage to use the default. */
    title?: string;
    description?: string;
    /** Path of an image inside /public, used for link previews. */
    image?: string;
}

const siteName = "Klinik Pratama Millenium";
const defaultTitle = "Klinik Pratama Millenium Medan";
const defaultDescription =
    "Klinik Pratama Millenium di Jl. Kapten Muslim, Medan Helvetia. Dokter umum, dokter gigi, KIA & KB, laboratorium, USG, apotek. Mitra BPJS Kesehatan.";

const { title, description = defaultDescription, image = "/og-image.jpg" } = Astro.props;

const pageTitle = title ? `${title} | ${siteName}` : defaultTitle;

// Falls back to the current origin if `site` isn't set in astro.config.mjs yet
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

const schema = {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    name: siteName,
    url: site.href,
    image: ogImage.href,
    description,
    telephone: "+62-61-8446652",
    email: "klinikmillenium.74@gmail.com",
    address: {
        "@type": "PostalAddress",
        streetAddress: "Jalan Kapten Muslim No. 18 C",
        addressLocality: "Medan",
        addressRegion: "Sumatera Utara",
        postalCode: "20124",
        addressCountry: "ID",
    },
    // TODO: right-click the clinic's pin on Google Maps, copy the coordinates, then uncomment:
    // geo: { "@type": "GeoCoordinates", latitude: 0, longitude: 0 },
    hasMap: "https://www.google.com/maps/search/?api=1&query=Klinik+Pratama+Millenium+Jalan+Kapten+Muslim+No.+18C+Medan",
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            opens: "07:00",
            closes: "23:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: "Sunday",
            opens: "08:00",
            closes: "23:00",
        },
    ],
    sameAs: [
        "https://instagram.com/klinik_millenium",
        "https://www.tiktok.com/@klinikmillenium",
    ],
};
---

<!doctype html>
<html lang="id" class="motion-safe:scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO -->
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph (WhatsApp, Facebook, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${siteName}, Medan`} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
	</head>
	<body>
		<div class="max-w-[2000px] mx-auto">
			<Navbar />
			<slot />
			<Footer />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>